# LLM Provider — GitHub Models (recommended for CI)
LLM_PROVIDER=github-models
GH_MODELS_TOKEN=github_pat_your_token_here
GITHUB_MODELS_MODEL=openai/gpt-4.1

# Policies directory (absolute path)
POLICIES_DIR=/absolute/path/to/arch_agent_ci-demo/policies

# Optional per-agent model selection
# INTAKE_MODEL=openai/gpt-4.1-mini
# AUDITOR_MODEL=openai/gpt-4.1

# Temperature and token limits
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
